generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Funcionario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  pedidos   Pedido[] 
  criadoEm  DateTime @default(now())
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  pedidos   Pedido[]
  criadoEm  DateTime @default(now())
}

model Pedido {
  id            Int            @id @default(autoincrement())
  status        Status         @default(PENDENTE)
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  clienteId     Int
  funcionario   Funcionario?   @relation(fields: [funcionarioId], references: [id])
  funcionarioId Int?
  criadoEm      DateTime       @default(now())
  itens         ItemPedido[]
  avaliacao     Avaliacao?
}

model Produto {
  id          Int            @id @default(autoincrement())
  nome        String
  preco       Float
  descricao   String?
  estoque     Int            @default(0)
  criadoEm    DateTime       @default(now())
  itens       ItemPedido[]
}

model ItemPedido {
  id          Int      @id @default(autoincrement())
  quantidade  Int
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  pedidoId    Int
  produto     Produto  @relation(fields: [produtoId], references: [id])
  produtoId   Int
}

model Avaliacao {
  id          Int      @id @default(autoincrement())
  nota        Int      @default(0)
  comentario  String?
  criadoEm    DateTime @default(now())
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  pedidoId    Int      @unique
}

enum Status {
  PENDENTE
  ACEITO
  RECUSADO
  ENTREGUE
}

model Gestor {
  id        Int      @id @default(autoincrement())
  nome      String?
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  ativo     Boolean  @default(true) 
  avatarUrl String?
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   
  details     String?  
  targetId    Int      
  targetType  String   @default("GESTOR") 
  authorId    Int?     
  authorName  String?  
  createdAt   DateTime @default(now())

  @@index([targetId, targetType])
}